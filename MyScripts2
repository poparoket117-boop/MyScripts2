-- DrunixHub :: Free Animation Only
local originalScript = loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/5857a6cfae3b902eb3c2dff7cdbf173b.lua"))()

-- Ждём, пока загрузится GUI
task.wait(1)

-- Ищем все ScreenGui
for _, gui in pairs(game:GetService("CoreGui"):GetChildren()) do
    if gui:IsA("ScreenGui") then
        -- Проходим по всем кнопкам/фреймам
        for _, child in pairs(gui:GetDescendants()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                -- Если текст кнопки НЕ содержит "Free Animation" — удаляем
                if child.Text and not child.Text:find("Free Animation") then
                    child:Destroy()
                end
            end
            if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                -- Если внутри фрейма нет кнопок с "Free Animation" — удаляем фрейм
                local hasFreeAnim = false
                for _, btn in pairs(child:GetDescendants()) do
                    if btn:IsA("TextButton") and btn.Text and btn.Text:find("Free Animation") then
                        hasFreeAnim = true
                        break
                    end
                end
                if not hasFreeAnim then
                    child:Destroy()
                end
            end
        end
    end
end

print("DrunixHub: Only 'Free Animation' left.")
