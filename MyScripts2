-- DrunixHub :: Free Animation (как в том скрипте)
local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local isAnimating = false
local animTrack = nil

-- Создаём кнопку
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DrunixHub"
screenGui.ResetOnSpawn = false

local btn = Instance.new("TextButton", screenGui)
btn.Size = UDim2.new(0, 200, 0, 55)
btn.Position = UDim2.new(0.5, -100, 0.8, 0)
btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Text = "🎭 Free Animation"
btn.TextSize = 22
btn.Font = Enum.Font.GothamBold
btn.BorderSizePixel = 0
local corner = Instance.new("UICorner", btn)
corner.CornerRadius = UDim.new(0, 12)

btn.MouseButton1Click:Connect(function()
    if not hum then return end
    isAnimating = not isAnimating
    
    if isAnimating then
        -- Механика из того скрипта (бег)
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://507767531"  -- стандартный бег
        animTrack = hum:LoadAnimation(anim)
        animTrack:Play()
        
        btn.Text = "🛑 Stop Animation"
        btn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    else
        if animTrack then
            animTrack:Stop()
            animTrack:Destroy()
        end
        btn.Text = "🎭 Free Animation"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

-- Сброс при респавне
player.CharacterAdded:Connect(function(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    if isAnimating then
        isAnimating = false
        btn.Text = "🎭 Free Animation"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

screenGui.Parent = game:GetService("CoreGui")

print("DrunixHub: Free Animation loaded!")
