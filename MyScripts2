-- DrunixHub :: Universal Run Animation (работает везде)
local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")

local isRunning = false

-- Создаём кнопку
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DrunixHub"
screenGui.ResetOnSpawn = false

local btn = Instance.new("TextButton", screenGui)
btn.Size = UDim2.new(0, 200, 0, 55)
btn.Position = UDim2.new(0.5, -100, 0.8, 0)
btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Text = "🏃 Run Animation"
btn.TextSize = 22
btn.Font = Enum.Font.GothamBold
btn.BorderSizePixel = 0
local corner = Instance.new("UICorner", btn)
corner.CornerRadius = UDim.new(0, 12)

btn.MouseButton1Click:Connect(function()
    if not hum then return end
    isRunning = not isRunning
    
    if isRunning then
        -- Включаем анимацию бега через Humanoid
        hum.WalkSpeed = 22
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        hum:ChangeState(Enum.HumanoidStateType.Running)
        
        btn.Text = "🛑 Stop Run"
        btn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    else
        hum.WalkSpeed = 16
        hum:ChangeState(Enum.HumanoidStateType.Running)
        btn.Text = "🏃 Run Animation"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

-- Сброс при респавне
player.CharacterAdded:Connect(function(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    if isRunning then
        isRunning = false
        hum.WalkSpeed = 16
        btn.Text = "🏃 Run Animation"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

screenGui.Parent = game:GetService("CoreGui")

print("DrunixHub: Run Animation loaded!")
