-- DrunixHub :: Zombie Run (для MM2 / Ragdoll)
local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")

local isZombie = false
local normalSpeed = 16
local zombieSpeed = 50

-- Создаём кнопку
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DrunixHub"
screenGui.ResetOnSpawn = false

local btn = Instance.new("TextButton", screenGui)
btn.Size = UDim2.new(0, 180, 0, 55)
btn.Position = UDim2.new(0.5, -90, 0.8, 0)
btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Text = "🧟 Zombie Run"
btn.TextSize = 22
btn.Font = Enum.Font.GothamBold
btn.BorderSizePixel = 0
local corner = Instance.new("UICorner", btn)
corner.CornerRadius = UDim.new(0, 12)

local function startZombie()
    if not hum then return end
    hum.WalkSpeed = zombieSpeed
    -- Дёрганое движение (эффект зомби)
    game:GetService("RunService").Heartbeat:Connect(function()
        if isZombie and root then
            root.CFrame = root.CFrame * CFrame.Angles(0, 0.15, 0)
        end
    end)
end

btn.MouseButton1Click:Connect(function()
    if not hum then return end
    isZombie = not isZombie
    
    if isZombie then
        startZombie()
        btn.Text = "🧟 Stop Zombie"
        btn.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    else
        hum.WalkSpeed = normalSpeed
        btn.Text = "🧟 Zombie Run"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

-- Сброс при респавне
player.CharacterAdded:Connect(function(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")
    if isZombie then
        isZombie = false
        hum.WalkSpeed = normalSpeed
        btn.Text = "🧟 Zombie Run"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    end
end)

screenGui.Parent = game:GetService("CoreGui")

print("DrunixHub: Zombie Run loaded for MM2/Ragdoll!")
